# Copy this file to .env for local development.
# Do not commit .env or real credentials.

# Supabase project URL (for example: https://your-project-ref.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon client key. Never use the service_role/secret key here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: override the deployed Edge Function name used by the app.
# EXPO_PUBLIC_WIG_GENERATION_FUNCTION=generate-wig-preview
# EXPO_PUBLIC_CHATBOT_AI_FUNCTION=generate-chatbot-reply
